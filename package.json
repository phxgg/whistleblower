{
  "name": "whistleblower",
  "version": "1.0.0",
  "description": "Discord bot that keeps track of everything happening on your server.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "register": "node --env-file-if-exists=.env scripts/register.mjs",
    "delete": "node --env-file-if-exists=.env scripts/delete.mjs",
    "bot": "node --env-file-if-exists=.env src/index.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" src/index.js",
    "test": "node --test",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "ncu:check": "npx npm-check-updates",
    "ncu:update": "npx npm-check-updates -u",
    "bump-deps": "npm run ncu:update && npm install && git add . && git commit -m \"chore: bump deps\""
  },
  "author": "phxgg",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "discord-api-types": "^0.38.56",
    "discord.js": "^14.27.0",
    "form-data": "^4.0.6",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.2",
    "nodemon": "^3.1.14",
    "redis": "^6.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "3.9.10"
  }
}
